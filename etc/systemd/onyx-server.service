# Provision the dedicated account and private configuration before enabling.
# Host path/account overrides belong in systemctl edit onyx-server.
# See docs/guide/service-management.md for installation and upgrade acceptance.
[Unit]
Description=Onyx Server secured IRC/IRCX mesh daemon
Documentation=https://github.com/devinkbrown/onyx-server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Process creation is not IRC/mesh readiness; there is no sd_notify protocol.
Type=exec
User=onyx-server
Group=onyx-server
WorkingDirectory=/var/lib/onyx-server
StateDirectory=onyx-server
StateDirectoryMode=0700
RuntimeDirectory=onyx-server
RuntimeDirectoryMode=0700
UMask=0077

# All commands run with the service identity, working directory and sandbox.
ExecStartPre=/usr/local/bin/onyx-server --check-config /etc/onyx-server/onyx-server.toml
ExecStart=/usr/local/bin/onyx-server /etc/onyx-server/onyx-server.toml
# A failed candidate preflight prevents the signal. This requests a Helix image
# upgrade, not config-only REHASH. Completion is asynchronous: inspect daemon
# upgrade results, client continuity and secured mesh before accepting a release.
ExecReload=/usr/local/bin/onyx-server --check-config /etc/onyx-server/onyx-server.toml
ExecReload=/bin/kill -USR2 $MAINPID

Restart=on-failure
RestartSec=2s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=onyx-server

# Default IRC ports (6667/6697) are above 1023 and need no capability.
# For an explicitly configured privileged port, review a capability drop-in.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
# io_uring and descriptor-based Helix execution must remain available. The
# contents of systemd syscall groups vary by release; include these explicitly.
SystemCallFilter=@system-service io_uring_setup io_uring_enter io_uring_register memfd_create execveat pidfd_open pidfd_send_signal rt_sigprocmask rt_sigpending
SystemCallFilter=~@mount @reboot @swap @cpu-emulation @obsolete @debug @clock
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
